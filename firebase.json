{
  "hosting": {
    "site": "precmed",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "prescmed",
          "region": "southamerica-east1"
        }
      }
    ]
  }
}
