rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAuthenticatedOwner(userId) {
      return request.auth != null && request.auth.uid == userId && isValidId(userId);
    }

    // =======================================================================
    // PresCMed (PCM) — Isolamento estrito por médico autenticado (LGPD)
    // =======================================================================
    function isValidWorkContextDoc(data) {
      return data.keys().size() <= 30 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 300;
    }

    function isValidPrescriptionModelDoc(data) {
      return data.keys().size() <= 30 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             (data.isTemplate == true || data._deleted == true);
    }

    match /users/{userId} {
      allow read, write: if isAuthenticatedOwner(userId);

      // Postos de trabalho e timbrados institucionais (sem dados de pacientes)
      match /work_contexts/{contextId} {
        allow read, delete: if isAuthenticatedOwner(userId) && isValidId(contextId);
        allow create, update: if isAuthenticatedOwner(userId) && isValidId(contextId) && isValidWorkContextDoc(incoming());
      }

      // Modelos de prescrição e templates rápidos reutilizáveis (bloqueia prontuários de pacientes via isTemplate == true)
      match /prescription_models/{modelId} {
        allow read, delete: if isAuthenticatedOwner(userId) && isValidId(modelId);
        allow create, update: if isAuthenticatedOwner(userId) && isValidId(modelId) && isValidPrescriptionModelDoc(incoming());
      }
    }
  }
}
