rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra global: negar acesso a qualquer documento não explicitamente liberado
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolamento estrito por médico autenticado (Zero-Knowledge / LGPD)
    match /users/{userId} {
      // O médico só pode ler ou gravar seus próprios metadados
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Postos de trabalho e timbrados institucionais (sem dados de pacientes)
      match /work_contexts/{contextId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Modelos de prescrição e templates rápidos reutilizáveis
      match /prescription_models/{modelId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
