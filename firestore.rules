rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == 'cAcz0LkJMEhNZIkoJbKpqJ9Svff1';
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidMuralCard(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.type is string && (data.type in ['doc', 'sheet', 'task', 'idea', 'media', 'keep']) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 100)) &&
             (!('author' in data) || (data.author is string && data.author.size() <= 100)) &&
             (!('pinned' in data) || data.pinned is bool) &&
             (!('locked' in data) || data.locked is bool) &&
             isOptionalNumber(data, 'x') && isOptionalNumber(data, 'y') &&
             isOptionalNumber(data, 'width') && isOptionalNumber(data, 'height') &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2048));
    }

    function isValidAgentMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.category is string && data.category.size() <= 100 &&
             data.title is string && data.title.size() <= 200 &&
             data.detail is string && data.detail.size() <= 5000;
    }

    function isValidKeepNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             (!('color' in data) || (data.color is string && data.color.size() <= 100)) &&
             (!('pinned' in data) || data.pinned is bool);
    }

    // 0. Teste de conexão
    match /test/{docId} {
      allow read: if isOwner();
    }

    // 1. Mural Cards Collection
    match /mural_cards/{cardId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && isValidId(cardId) && isValidMuralCard(incoming());
      allow delete: if isOwner() && isValidId(cardId);
    }

    // 2. Agent Memory Collection
    match /agent_memory/{memoryId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && isValidId(memoryId) && isValidAgentMemory(incoming());
      allow delete: if isOwner() && isValidId(memoryId);
    }

    // 3. Keep Notes Collection
    match /keep_notes/{noteId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && isValidId(noteId) && isValidKeepNote(incoming());
      allow delete: if isOwner() && isValidId(noteId);
    }

    // =======================================================================
    // 4. PresCMed (PCM) — Isolamento estrito por médico autenticado (LGPD)
    // =======================================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Postos de trabalho e timbrados institucionais (sem dados de pacientes)
      match /work_contexts/{contextId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Modelos de prescrição e templates rápidos reutilizáveis
      match /prescription_models/{modelId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
